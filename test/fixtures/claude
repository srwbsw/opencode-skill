#!/usr/bin/env node
// Fake `claude` binary for testing review.js/agent.js flag passthrough.
// Dumps its argv (newline-joined) to $FAKE_ARGV_FILE when set, then prints an
// envelope-wrapped ok marker and exits 0. Lets tests assert which flags are
// forwarded to the Claude Code CLI (notably --print, --model, and the
// --permission-mode plan safety flag, which agent.js must never forward).

'use strict';

const fs = require('fs');

const file = process.env.FAKE_ARGV_FILE;
if (file) {
  try {
    fs.writeFileSync(file, process.argv.slice(2).join('\n') + '\n');
  } catch {
    /* best-effort; test will fail on its own assertion if this is missing */
  }
}

process.stdout.write(
  '<<<SECOND_OPINION_START>>>\n[fake-claude ok] review complete\n<<<SECOND_OPINION_END>>>\n'
);
process.exit(0);
