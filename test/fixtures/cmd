#!/usr/bin/env node
// Fake `cmd` (Command Code) binary for testing review.js model passthrough.
// Dumps its argv (newline-joined) to $FAKE_ARGV_FILE when set, then prints an
// ok marker and exits 0. Lets tests assert which flags review.js forwards to
// the Command Code CLI (notably -m/--model and --skip-onboarding).

'use strict';

const fs = require('fs');

const file = process.env.FAKE_ARGV_FILE;
if (file) {
  try {
    fs.writeFileSync(file, process.argv.slice(2).join('\n') + '\n');
  } catch {
    /* best-effort; test will fail on its own assertion if this is missing */
  }
}

process.stdout.write('[fake-cmd ok] review complete\n');
process.exit(0);
