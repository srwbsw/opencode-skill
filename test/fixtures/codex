#!/usr/bin/env node
// Fake `codex` binary for testing review.js spawn behaviour.
// Behaviour is controlled by the FAKE_BEHAVIOR env var:
//   ok          — print an envelope-wrapped "[fake-codex ok]" and exit 0
//   silent N    — sleep N seconds with no output, then envelope + exit 0 (N=5)
//   hang        — sleep 600 seconds (test timeout/SIGTERM handling)
//   echo-stdin  — read stdin until EOF and print marker + byte count (wrapped)
//   probe N     — append "START <pid> <ms>" to $FAKE_PROBE_FILE, sleep N
//                 seconds (default 1), append "END <pid> <ms>", envelope, exit 0.
//                 Lets the concurrency test detect overlapping vs serialized
//                 fusion children by comparing intervals.
//   malformed-marker — open marker with only two '>' (near-miss); review.js
//                 must still detect the envelope (tolerant matching)
//   empty       — print NOTHING and exit 0 (models a silent upstream outage)
//   noenvelope  — print plain text WITHOUT the <<<SECOND_OPINION_*>>> markers
//                 and exit 0 (models an engine that ignored the output format)
//
// When $FAKE_ARGV_FILE is set, the fixture dumps its argv (newline-joined) to
// that file before doing anything else, so tests can assert which flags
// review.js forwarded (e.g. --skip-git-repo-check).
//
// Compliant behaviours wrap their output in the structured-output envelope so
// review.js's envelope check (exit 3 on missing envelope) treats them as a
// well-behaved engine. The `empty` and `noenvelope` behaviours deliberately
// violate that contract to exercise the failure path.

'use strict';

const fs = require('fs');

const argvFile = process.env.FAKE_ARGV_FILE;
if (argvFile) {
  try {
    fs.writeFileSync(argvFile, process.argv.slice(2).join('\n') + '\n');
  } catch {
    /* best-effort; the test asserts on its own */
  }
}

const behaviorRaw = (process.env.FAKE_BEHAVIOR || 'ok').trim();
const [behavior, ...behaviorArgs] = behaviorRaw.split(/\s+/);

function sleep(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

// Wrap a body in the structured-output envelope review.js expects.
function emit(body) {
  process.stdout.write(
    `<<<SECOND_OPINION_START>>>\n${body}\n<<<SECOND_OPINION_END>>>\n`
  );
}

async function main() {
  switch (behavior) {
    case 'ok': {
      emit('[fake-codex ok] review complete');
      return 0;
    }
    case 'silent': {
      const sec = Number(behaviorArgs[0]) || 5;
      await sleep(sec * 1000);
      emit(`[fake-codex silent ${sec}s] done`);
      return 0;
    }
    case 'hang': {
      // Stay alive long enough that the timeout path is the only way out.
      // Listen for SIGTERM so we can confirm the runner is killing us.
      process.on('SIGTERM', () => {
        process.stderr.write('[fake-codex hang] received SIGTERM, exiting\n');
        process.exit(143);
      });
      await sleep(600 * 1000);
      return 0;
    }
    case 'malformed-marker': {
      // Open marker with only TWO '>' (a real cmd near-miss). review.js must
      // still recognize it as an envelope (tolerant detection), not exit 3.
      process.stdout.write(
        '<<<SECOND_OPINION_START>>\n[fake-codex malformed] usable review body\n<<<SECOND_OPINION_END>>>\n'
      );
      return 0;
    }
    case 'empty': {
      // Model a silent upstream outage: clean exit, zero bytes of output.
      return 0;
    }
    case 'noenvelope': {
      // Output without the required envelope markers.
      process.stdout.write('[fake-codex noenvelope] plain text, no markers\n');
      return 0;
    }
    case 'probe': {
      const sec = Number(behaviorArgs[0]) || 1;
      const file = process.env.FAKE_PROBE_FILE;
      if (!file) {
        process.stderr.write('[fake-codex probe] FAKE_PROBE_FILE unset\n');
        return 1;
      }
      fs.appendFileSync(file, `START ${process.pid} ${Date.now()}\n`);
      await sleep(sec * 1000);
      fs.appendFileSync(file, `END ${process.pid} ${Date.now()}\n`);
      emit('[fake-codex probe] done');
      return 0;
    }
    case 'echo-stdin': {
      // If review.js correctly sets stdio[0]='ignore', stdin is closed and
      // this resolves immediately with 0 bytes read. If review.js inherits
      // stdin from a non-EOF source, this hangs.
      let bytes = 0;
      let timedOut = false;
      const timer = setTimeout(() => {
        timedOut = true;
        emit('[fake-codex echo-stdin] STDIN_HANG');
        process.exit(2);
      }, 3000);
      process.stdin.on('data', (chunk) => {
        bytes += chunk.length;
      });
      await new Promise((resolve) => {
        process.stdin.on('end', () => {
          clearTimeout(timer);
          if (!timedOut) {
            emit(`[fake-codex echo-stdin] STDIN_CLOSED bytes=${bytes}`);
          }
          resolve();
        });
        process.stdin.on('error', () => {
          clearTimeout(timer);
          emit('[fake-codex echo-stdin] STDIN_ERROR');
          resolve();
        });
      });
      return 0;
    }
    default:
      process.stderr.write(
        `[fake-codex] unknown FAKE_BEHAVIOR='${behaviorRaw}'\n`
      );
      return 1;
  }
}

main().then((code) => process.exit(code));
