#!/usr/bin/env node
// Fake `codex` binary for testing review.js spawn behaviour.
// Behaviour is controlled by the FAKE_BEHAVIOR env var:
//   ok          — print an envelope-wrapped "[fake-codex ok]" and exit 0
//   silent N    — sleep N seconds with no output, then envelope + exit 0 (N=5)
//   hang        — sleep 600 seconds (test timeout/SIGTERM handling)
//   echo-stdin  — read stdin until EOF and print marker + byte count (wrapped)
//   probe N     — append "START <pid> <ms>" to $FAKE_PROBE_FILE, sleep N
//                 seconds (default 1), append "END <pid> <ms>", envelope, exit 0.
//                 Lets the concurrency test detect overlapping vs serialized
//                 fusion children by comparing intervals.
//   malformed-marker — open marker with only two '>' (near-miss); review.js
//                 must still detect the envelope (tolerant matching)
//   malformed   — BOTH open and close markers use only two '<'/'>' each
//                 (e.g. <<SECOND_OPINION_START>> / <<SECOND_OPINION_END>>).
//                 Exercises tolerant-regex extraction on both ends, not just
//                 the open marker (see malformed-marker above).
//   double      — emit two complete envelope pairs with DIFFERENT payloads
//                 (models the codex double-echo quirk). Answer extraction
//                 must keep the LAST pair, not the first.
//   empty-final-pair — a REAL pair followed by a complete but EMPTY pair.
//                 Answer extraction must fall back to the last NON-EMPTY pair.
//   stray-start — a bare START marker echoed mid-reasoning, then the real
//                 pair. Backward pairing must return the clean payload only.
//   echo-instructions — real own-line pair, then an instruction sentence with
//                 both markers INLINE. Line-anchored extraction must keep the
//                 real payload, never the inline fragment.
//   inline-only — ONLY the inline instruction sentence (no own-line pair).
//                 No extractable answer → exit 3 when a log file is in use.
//   zero-payload — payload is the single character '0' (falsy as a string).
//                 Extraction must treat it as a real answer, not "no answer".
//   big N       — ~N MB payload (default 2) ending in BIG_PAYLOAD_END_MARKER.
//                 Exercises review.js's synchronous stdout flush: a large
//                 --print-answer echo must not truncate or drop the trailing
//                 SECOND_OPINION_RESULT line on process.exit().
//   empty       — print NOTHING and exit 0 (models a silent upstream outage)
//   noenvelope  — print plain text WITHOUT the <<<SECOND_OPINION_*>>> markers
//                 and exit 0 (models an engine that ignored the output format)
//   model-unavailable — fail when -m/--model is present, succeed otherwise.
//                 Models Codex rejecting a pinned unavailable model.
//   write-file  — write a file into $FAKE_WRITE_FILE (a path resolved
//                 against the CURRENT working directory — i.e. --cwd, since
//                 the child inherits it), then envelope + exit 0. Models an
//                 unrestricted agent.js run that completed a task and
//                 modified the repository.
//   write-file-noenvelope — same file write as write-file, but the output is
//                 plain text WITHOUT the envelope markers (models an engine
//                 that made real changes but ignored the output-format
//                 request — exercises agent.js's "NO REPORT" warning path).
//   commit-noenvelope — runs `git add -A && git commit` in the current
//                 working directory (moving HEAD), then prints plain text
//                 WITHOUT the envelope markers. Models an engine that commits
//                 its own work: porcelain status comes back CLEAN (no
//                 uncommitted files) even though real work happened —
//                 exercises agent.js's verdict counting HEAD movement as a
//                 change (not just dirty-porcelain files).
//   delete-file — deletes the tracked file at $FAKE_WRITE_FILE (resolved
//                 against the current working directory), then envelope +
//                 exit 0. Models an unrestricted agent.js run that removed a
//                 tracked file — exercises change-reporting's 'D' → 'deleted'
//                 classification. Also reused (against a NEVER-`git add`ed
//                 path) to model an engine deleting an ALREADY-UNTRACKED
//                 file: the path is '??' in the BEFORE snapshot and absent
//                 from git status entirely in AFTER — a before-only path
//                 diffPorcelain must classify as 'deleted', not drop.
//   delete-file-noenvelope — same delete as delete-file, but the output is
//                 plain text WITHOUT the envelope markers. Used against an
//                 already-untracked path to exercise the "no envelope, but a
//                 before-only vanished path is still real work" verdict —
//                 must be exit 0 + NO REPORT, never a false exit 3.
//   revert-file — runs `git checkout -- $FAKE_WRITE_FILE` in the current
//                 working directory (reverting it to its committed content),
//                 then envelope + exit 0. Models an engine that reverts an
//                 ALREADY-DIRTY tracked file back to exactly what's
//                 committed: the path is ' M' (or similar) in the BEFORE
//                 snapshot and absent from git status entirely in AFTER
//                 (byte-identical to HEAD again) — a before-only path that
//                 diffPorcelain must classify as 'modified' (real content
//                 change relative to BEFORE), not drop.
//   start-only  — emits ONLY the START marker (no END, no payload), then
//                 exit 0. Exercises agent.js's STRICT no-log-file envelope
//                 watcher (a lone START marker must NOT count as usable —
//                 unlike review.js's loose presence-only streaming check,
//                 which stays unchanged and DOES treat this as "seen"). Also
//                 used (with a read-only --log=<path>, forcing an async
//                 log-stream open failure) to exercise the same strict rule
//                 on agent.js's logUsable-false FALLBACK path — see agent.js's
//                 strictEnvelope: true.
//   large-then-envelope — writes ~5MB of plain padding (no markers), then a
//                 real, small envelope pair, then exits 0. Models a verbose
//                 reasoning trace preceding a compact final answer — the
//                 padding alone exceeds the strict envelope watcher's ~4MB
//                 tail cap, so this exercises the cap's truncation design:
//                 the real pair, living at the very end of the stream, must
//                 still extract even though the padding pushed the total
//                 stream size well past the cap.
//   hang-grandchild — spawns a plain (non-detached) grandchild that appends
//                 a timestamp line to $FAKE_PROBE_FILE every ~200ms, then
//                 hangs like `hang` (listens for SIGTERM, sleeps 600s). The
//                 grandchild does NOT detach itself — it inherits whatever
//                 process GROUP it was spawned into, exactly like a real
//                 engine's own subprocess would. Exercises run.js's timeout
//                 kill actually tearing down the whole process tree/group,
//                 not just this one process.
//
// When $FAKE_ARGV_FILE is set, the fixture dumps its argv (newline-joined) to
// that file before doing anything else, so tests can assert which flags
// review.js forwarded (e.g. --skip-git-repo-check).
//
// Compliant behaviours wrap their output in the structured-output envelope so
// review.js's envelope check (exit 3 on missing envelope) treats them as a
// well-behaved engine. The `empty` and `noenvelope` behaviours deliberately
// violate that contract to exercise the failure path.

'use strict';

const fs = require('fs');
const { spawn, spawnSync } = require('child_process');

const argvFile = process.env.FAKE_ARGV_FILE;
if (argvFile) {
  try {
    fs.writeFileSync(argvFile, process.argv.slice(2).join('\n') + '\n');
  } catch {
    /* best-effort; the test asserts on its own */
  }
}

const behaviorRaw = (process.env.FAKE_BEHAVIOR || 'ok').trim();
const [behavior, ...behaviorArgs] = behaviorRaw.split(/\s+/);

function sleep(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

// Wrap a body in the structured-output envelope review.js expects.
function emit(body) {
  process.stdout.write(
    `<<<SECOND_OPINION_START>>>\n${body}\n<<<SECOND_OPINION_END>>>\n`
  );
}

async function main() {
  switch (behavior) {
    case 'ok': {
      emit('[fake-codex ok] review complete');
      return 0;
    }
    case 'silent': {
      const sec = Number(behaviorArgs[0]) || 5;
      await sleep(sec * 1000);
      emit(`[fake-codex silent ${sec}s] done`);
      return 0;
    }
    case 'hang': {
      // Stay alive long enough that the timeout path is the only way out.
      // Listen for SIGTERM so we can confirm the runner is killing us.
      process.on('SIGTERM', () => {
        process.stderr.write('[fake-codex hang] received SIGTERM, exiting\n');
        process.exit(143);
      });
      await sleep(600 * 1000);
      return 0;
    }
    case 'hang-grandchild': {
      const file = process.env.FAKE_PROBE_FILE;
      if (!file) {
        process.stderr.write(
          '[fake-codex hang-grandchild] FAKE_PROBE_FILE unset\n'
        );
        return 1;
      }
      // Plain, non-detached grandchild that keeps appending a timestamp to
      // the probe file every ~200ms. If the runner's timeout kill only
      // signals ITS direct child (this fixture process, or a PTY wrapper
      // above it) instead of the whole process GROUP, this grandchild is
      // orphaned by that kill and keeps writing forever.
      const script =
        'const fs=require("fs");' +
        `setInterval(()=>{try{fs.appendFileSync(${JSON.stringify(file)},Date.now()+"\\n");}catch{}},200);`;
      const gc = spawn(process.execPath, ['-e', script], { stdio: 'ignore' });
      gc.unref();
      process.on('SIGTERM', () => {
        // The fixture itself dies as instructed; the assertion is entirely
        // about whether its grandchild also dies.
        process.exit(143);
      });
      await sleep(600 * 1000);
      return 0;
    }
    case 'malformed-marker': {
      // Open marker with only TWO '>' (a real cmd near-miss). review.js must
      // still recognize it as an envelope (tolerant detection), not exit 3.
      process.stdout.write(
        '<<<SECOND_OPINION_START>>\n[fake-codex malformed] usable review body\n<<<SECOND_OPINION_END>>>\n'
      );
      return 0;
    }
    case 'malformed': {
      // BOTH markers near-miss: only TWO '<'/'>' on open AND close. Exercises
      // tolerant-regex answer extraction on the close marker too (not just
      // the envelope-presence check, which only ever looks at the open side).
      process.stdout.write(
        '<<SECOND_OPINION_START>>\n[fake-codex malformed-both] TOLERANT_PAYLOAD_MARKER\n<<SECOND_OPINION_END>>\n'
      );
      return 0;
    }
    case 'double': {
      // Emit two COMPLETE envelope pairs with different payloads, modeling an
      // engine that echoes the output format instructions or otherwise
      // duplicates its answer. Answer extraction must keep the LAST pair.
      emit('[fake-codex double] FIRST_PAYLOAD_MARKER (stale)');
      emit('[fake-codex double] SECOND_PAYLOAD_MARKER (final)');
      return 0;
    }
    case 'empty-final-pair': {
      // A real answer followed by a complete-but-EMPTY trailing pair (models
      // an engine echoing a blank template after its answer). Extraction must
      // return the REAL payload, not treat the empty final pair as "the last
      // pair" and discard the answer.
      emit('[fake-codex empty-final-pair] REAL_CONTENT_MARKER');
      emit('');
      return 0;
    }
    case 'stray-start': {
      // A bare START marker echoed mid-reasoning (no matching END), followed
      // by the real pair. Backward pairing must bind the real pair's own
      // START — the LAST one before the END — not let the stray marker
      // swallow reasoning text (and the real START) into the payload.
      process.stdout.write(
        'echoing the marker as instructed:\n' +
          '<<<SECOND_OPINION_START>>>\n' +
          'more reasoning before the real answer\n' +
          '<<<SECOND_OPINION_START>>>\nREAL_CLEAN_PAYLOAD\n<<<SECOND_OPINION_END>>>\n'
      );
      return 0;
    }
    case 'echo-instructions': {
      // Real own-line envelope first, then an echoed instruction sentence
      // with BOTH markers INLINE (models an engine parroting the OUTPUT
      // FORMAT prompt after its answer). Line-anchored extraction must keep
      // the real payload — the inline "pair" (whose payload would be the
      // word "and") must never win the backward walk.
      emit('[fake-codex echo-instructions] REAL_ANSWER_MARKER');
      process.stdout.write(
        'Reminder: wrap your final answer between <<<SECOND_OPINION_START>>> and <<<SECOND_OPINION_END>>> exactly.\n'
      );
      return 0;
    }
    case 'inline-only': {
      // ONLY the echoed instruction sentence — the markers never appear on
      // their own line. Extraction must find no pair; with a log file in use
      // that makes the run "no usable output" (exit 3), even though a loose
      // unanchored presence check would have seen the marker text.
      process.stdout.write(
        'Wrap your final answer between <<<SECOND_OPINION_START>>> and <<<SECOND_OPINION_END>>> exactly.\n'
      );
      return 0;
    }
    case 'zero-payload': {
      // Payload is the single character '0' — falsy as a string. Extraction
      // must not drop it via truthiness checks.
      emit('0');
      return 0;
    }
    case 'big': {
      // ~N MB payload (default 2), ending in a stable marker so tests can
      // assert the echo arrived un-truncated. A multi-MB write MUST be
      // awaited before exit — process.exit() discards async stdout still
      // queued on the pipe (the very failure mode this behavior exists to
      // pin in review.js), which would truncate the fixture's own output.
      const mb = Number(behaviorArgs[0]) || 2;
      const line = '[fake-codex big] 0123456789abcdef\n';
      const body = line.repeat(Math.ceil((mb * 1024 * 1024) / line.length));
      await new Promise((resolve) =>
        process.stdout.write(
          `<<<SECOND_OPINION_START>>>\n${body}BIG_PAYLOAD_END_MARKER\n<<<SECOND_OPINION_END>>>\n`,
          resolve
        )
      );
      return 0;
    }
    case 'large-then-envelope': {
      // ~5MB of plain padding (no markers) BEFORE a real, small envelope
      // pair — models a verbose reasoning trace preceding a compact final
      // answer. The padding alone exceeds the strict envelope watcher's
      // ~4MB tail cap (see envelope.js's STRICT_WATCHER_TAIL_CHARS), so this
      // exercises the cap's truncation design: the real pair, living at the
      // very end of the stream, must still extract even though the padding
      // pushed the total stream size well past the cap.
      const line = 'padding line filler text 0123456789abcdef\n';
      const padding = line.repeat(Math.ceil((5 * 1024 * 1024) / line.length));
      await new Promise((resolve) => process.stdout.write(padding, resolve));
      emit('[fake-codex large-then-envelope] REAL_ANSWER_AFTER_PADDING');
      return 0;
    }
    case 'empty': {
      // Model a silent upstream outage: clean exit, zero bytes of output.
      return 0;
    }
    case 'write-file': {
      // Write a file into the CURRENT working directory (the child inherits
      // --cwd), then envelope + exit 0. Models an unrestricted agent.js run
      // that completed a task and left a real change on disk.
      const target = process.env.FAKE_WRITE_FILE;
      if (target) {
        try {
          fs.writeFileSync(target, 'FAKE_WRITE_FILE_CONTENT\n');
        } catch (err) {
          process.stderr.write(
            `[fake-codex write-file] could not write '${target}': ${err.message}\n`
          );
        }
      }
      emit('[fake-codex write-file] task complete');
      return 0;
    }
    case 'write-file-noenvelope': {
      // Same file write as write-file, but the output is plain text WITHOUT
      // the envelope markers — models an engine that made real changes but
      // ignored the output-format request.
      const target = process.env.FAKE_WRITE_FILE;
      if (target) {
        try {
          fs.writeFileSync(target, 'FAKE_WRITE_FILE_CONTENT\n');
        } catch (err) {
          process.stderr.write(
            `[fake-codex write-file-noenvelope] could not write '${target}': ${err.message}\n`
          );
        }
      }
      process.stdout.write(
        '[fake-codex write-file-noenvelope] task complete, no envelope\n'
      );
      return 0;
    }
    case 'commit-noenvelope': {
      // Write a file, stage it, and commit it in the current working
      // directory (moving HEAD), then print plain text WITHOUT the envelope
      // markers. Models an engine that committed its own work — porcelain
      // status is CLEAN afterward, but real work happened (HEAD moved).
      try {
        fs.writeFileSync(
          'commit-noenvelope-output.txt',
          'FAKE_COMMIT_CONTENT\n'
        );
        spawnSync('git', ['add', '-A'], { stdio: 'ignore' });
        spawnSync('git', ['commit', '-qm', 'fake commit'], {
          stdio: 'ignore',
        });
      } catch (err) {
        process.stderr.write(
          `[fake-codex commit-noenvelope] git failed: ${err.message}\n`
        );
      }
      process.stdout.write(
        '[fake-codex commit-noenvelope] task complete, no envelope\n'
      );
      return 0;
    }
    case 'delete-file': {
      // Delete the tracked file at $FAKE_WRITE_FILE, then envelope + exit 0.
      // Exercises change-reporting's 'D' → 'deleted' classification.
      const target = process.env.FAKE_WRITE_FILE;
      if (target) {
        try {
          fs.unlinkSync(target);
        } catch (err) {
          process.stderr.write(
            `[fake-codex delete-file] could not delete '${target}': ${err.message}\n`
          );
        }
      }
      emit('[fake-codex delete-file] task complete');
      return 0;
    }
    case 'delete-file-noenvelope': {
      // Same delete as delete-file, but the output is plain text WITHOUT the
      // envelope markers — exercises the "no envelope, but a before-only
      // vanished path is still real work" verdict (must be exit 0 + NO
      // REPORT, never a false exit 3).
      const target = process.env.FAKE_WRITE_FILE;
      if (target) {
        try {
          fs.unlinkSync(target);
        } catch (err) {
          process.stderr.write(
            `[fake-codex delete-file-noenvelope] could not delete '${target}': ${err.message}\n`
          );
        }
      }
      process.stdout.write(
        '[fake-codex delete-file-noenvelope] task complete, no envelope\n'
      );
      return 0;
    }
    case 'revert-file': {
      // Revert the tracked file at $FAKE_WRITE_FILE to its committed content
      // (`git checkout -- <path>`), then envelope + exit 0. Models an engine
      // that reverts an ALREADY-DIRTY tracked file back to exactly what's
      // committed — the working tree ends up byte-identical to HEAD again,
      // so the path vanishes from `git status --porcelain` entirely (before:
      // dirty; after: absent) even though its content genuinely differs from
      // the run's BEFORE snapshot.
      const target = process.env.FAKE_WRITE_FILE;
      if (target) {
        const result = spawnSync('git', ['checkout', '--', target], {
          stdio: 'ignore',
        });
        if (result.status !== 0) {
          process.stderr.write(
            `[fake-codex revert-file] git checkout failed for '${target}'\n`
          );
        }
      }
      emit('[fake-codex revert-file] task complete');
      return 0;
    }
    case 'start-only': {
      // ONLY the START marker — no END, no payload. A real engine that got
      // cut off mid-stream (crash, sandbox kill) right after opening its
      // envelope looks like this.
      process.stdout.write('<<<SECOND_OPINION_START>>>\n');
      return 0;
    }
    case 'noenvelope': {
      // Output without the required envelope markers.
      process.stdout.write('[fake-codex noenvelope] plain text, no markers\n');
      return 0;
    }
    case 'model-unavailable': {
      const args = process.argv.slice(2);
      const hasModel = args.includes('-m') || args.includes('--model');
      if (hasModel) {
        const modelIdx = Math.max(args.indexOf('-m'), args.indexOf('--model'));
        const requested = args[modelIdx + 1] || '<missing>';
        process.stderr.write(`error: model '${requested}' not available\n`);
        return 2;
      }
      emit('[fake-codex model unavailable] default model review complete');
      return 0;
    }
    case 'probe': {
      const sec = Number(behaviorArgs[0]) || 1;
      const file = process.env.FAKE_PROBE_FILE;
      if (!file) {
        process.stderr.write('[fake-codex probe] FAKE_PROBE_FILE unset\n');
        return 1;
      }
      fs.appendFileSync(file, `START ${process.pid} ${Date.now()}\n`);
      await sleep(sec * 1000);
      fs.appendFileSync(file, `END ${process.pid} ${Date.now()}\n`);
      emit('[fake-codex probe] done');
      return 0;
    }
    case 'echo-stdin': {
      // If review.js correctly sets stdio[0]='ignore', stdin is closed and
      // this resolves immediately with 0 bytes read. If review.js inherits
      // stdin from a non-EOF source, this hangs.
      let bytes = 0;
      let timedOut = false;
      const timer = setTimeout(() => {
        timedOut = true;
        emit('[fake-codex echo-stdin] STDIN_HANG');
        process.exit(2);
      }, 3000);
      process.stdin.on('data', (chunk) => {
        bytes += chunk.length;
      });
      await new Promise((resolve) => {
        process.stdin.on('end', () => {
          clearTimeout(timer);
          if (!timedOut) {
            emit(`[fake-codex echo-stdin] STDIN_CLOSED bytes=${bytes}`);
          }
          resolve();
        });
        process.stdin.on('error', () => {
          clearTimeout(timer);
          emit('[fake-codex echo-stdin] STDIN_ERROR');
          resolve();
        });
      });
      return 0;
    }
    default:
      process.stderr.write(
        `[fake-codex] unknown FAKE_BEHAVIOR='${behaviorRaw}'\n`
      );
      return 1;
  }
}

main().then((code) => process.exit(code));
