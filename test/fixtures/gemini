#!/usr/bin/env node
// Fake `gemini` binary for testing review.js flag passthrough.
// Dumps its argv (newline-joined) to $FAKE_ARGV_FILE when set, then prints an
// envelope-wrapped ok marker and exits 0. Lets tests assert which flags
// review.js forwards to the Gemini CLI (notably --skip-trust, which bypasses
// the "untrusted directory" hard-fail in headless mode).

'use strict';

const fs = require('fs');

const file = process.env.FAKE_ARGV_FILE;
if (file) {
  try {
    fs.writeFileSync(file, process.argv.slice(2).join('\n') + '\n');
  } catch {
    /* best-effort; test will fail on its own assertion if this is missing */
  }
}

process.stdout.write(
  '<<<SECOND_OPINION_START>>>\n[fake-gemini ok] review complete\n<<<SECOND_OPINION_END>>>\n'
);
process.exit(0);
