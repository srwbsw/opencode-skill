#!/usr/bin/env node
// Fake `opencode` binary for testing review.js flag passthrough.
// Dumps its argv (newline-joined) to $FAKE_ARGV_FILE when set, then prints an
// envelope-wrapped ok marker and exits 0. Lets tests assert which flags
// review.js forwards to the opencode CLI (notably --dir <cwd>, which scopes
// the sandbox's file-access root so subtree reads aren't "external").

'use strict';

const fs = require('fs');

const file = process.env.FAKE_ARGV_FILE;
if (file) {
  try {
    fs.writeFileSync(file, process.argv.slice(2).join('\n') + '\n');
  } catch {
    /* best-effort; test will fail on its own assertion if this is missing */
  }
}

process.stdout.write(
  '<<<SECOND_OPINION_START>>>\n[fake-opencode ok] review complete\n<<<SECOND_OPINION_END>>>\n'
);
process.exit(0);
